    <string name="intro_start">Get started</string>
    <string name="intro_1_title">Your books, everywhere</string>
    <string name="intro_1_body">Kitaab keeps your PDF books and your reading progress in your own Google Drive.</string>
    <string name="intro_2_title">Sign in with Google</string>
    <string name="intro_2_body">Sign in once. Kitaab finds the folder \"books\" in your Drive, or creates it for you.</string>
    <string name="intro_3_title">Your own folder</string>
    <string name="intro_3_body">Type your name. Your books are kept in books / your name, together with one file, progress.json, that holds your reading progress.</string>
    <string name="intro_4_title">Continue on any phone</string>
    <string name="intro_4_body">Open a book on another phone and carry on from the same page. Add PDFs from the app, or copy them into your folder in Google Drive.</string>
