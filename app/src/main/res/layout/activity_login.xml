<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/kPrimary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:minHeight="600dp"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖"
            android:textSize="72sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="?attr/kTextOnDark"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your cross-device reading companion"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="40dp"/>

        <!-- Step 1: Google sign-in (required) -->
        <LinearLayout
            android:id="@+id/groupSignIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/login_hint"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="20dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/sign_in_google"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="?attr/kAccent"
                android:textColor="?attr/kTextOnAccent"
                app:cornerRadius="28dp"/>

            <ProgressBar
                android:id="@+id/progressSignIn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:indeterminateTint="?attr/kAccent"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Step 2: the name that becomes the folder books/<name> -->
        <LinearLayout
            android:id="@+id/groupName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_name_title"
                android:textColor="?attr/kTextOnDark"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/login_name_body"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:autofillHints="name"
                android:backgroundTint="?attr/kAccent"
                android:hint="@string/login_name_field"
                android:imeOptions="actionDone"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="40"
                android:minHeight="48dp"
                android:singleLine="true"
                android:textColor="?attr/kTextOnDark"
                android:textColorHint="#80FFFFFF"/>

            <TextView
                android:id="@+id/tvNameHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#FFDD88"
                android:textSize="13sp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/login_continue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="?attr/kAccent"
                android:textColor="?attr/kTextOnAccent"
                app:cornerRadius="28dp"/>

            <ProgressBar
                android:id="@+id/progressName"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="?attr/kAccent"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
