<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/kCardBg">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#44000000"/>

    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/kTextPrimary"
        android:layout_marginBottom="20dp"/>

    <!-- Stats row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvDetailPages"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" android:textStyle="bold" android:textColor="?attr/kAccent"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="pages read" android:textSize="11sp" android:textColor="?attr/kTextSecondary"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvDetailHours"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" android:textStyle="bold" android:textColor="?attr/kAccent"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="hours read" android:textSize="11sp" android:textColor="?attr/kTextSecondary"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvDetailProgress"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" android:textStyle="bold" android:textColor="?attr/kAccent"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="complete" android:textSize="11sp" android:textColor="?attr/kTextSecondary"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Detail rows -->
    <TextView android:id="@+id/tvDetailTotalPages"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="?attr/kTextSecondary"
        android:paddingVertical="4dp"/>
    <TextView android:id="@+id/tvDetailFileSize"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="?attr/kTextSecondary"
        android:paddingVertical="4dp"/>
    <TextView android:id="@+id/tvDetailLastRead"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="?attr/kTextSecondary"
        android:paddingVertical="4dp"/>
    <TextView android:id="@+id/tvDetailSyncStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="?attr/kTextSecondary"
        android:paddingVertical="4dp"
        android:layout_marginBottom="8dp"/>

</LinearLayout>
