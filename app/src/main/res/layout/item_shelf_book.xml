<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="22dp">

    <!-- Book standing on the shelf: cover with a spine shadow -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="6dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/kSurfaceVariant"
                android:contentDescription="Book cover"
                android:scaleType="centerCrop"/>
            <View
                android:layout_width="7dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_spine"/>
            <TextView
                android:id="@+id/tvRecordOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="@drawable/bg_badge_done"
                android:paddingHorizontal="5dp"
                android:text="record"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:visibility="gone"/>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="2"
        android:textColor="?attr/kTextPrimary"
        android:textSize="11sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvFinishedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/kTextSecondary"
        android:textSize="10sp"/>
</LinearLayout>
